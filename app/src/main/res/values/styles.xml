<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#1787D4</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="KeyStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">@dimen/key_gap</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">#263238</item>
        <item name="android:textSize">@dimen/key_text_size</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:tag">key</item>
    </style>

    <style name="HangulKeyStyle" parent="KeyStyle" />

    <style name="NumberKeyStyle" parent="KeyStyle">
        <item name="android:textSize">@dimen/number_text_size</item>
        <item name="android:tag">number</item>
    </style>

    <style name="SpecialKeyStyle" parent="KeyStyle">
        <item name="android:textSize">@dimen/special_text_size</item>
        <item name="android:tag">special</item>
    </style>

    <style name="PunctuationKeyStyle" parent="KeyStyle">
        <item name="android:layout_weight">0.75</item>
        <item name="android:textSize">@dimen/key_text_size</item>
    </style>

    <style name="SpaceKeyStyle" parent="KeyStyle">
        <item name="android:layout_weight">3</item>
        <item name="android:textSize">@dimen/space_text_size</item>
        <item name="android:tag">space</item>
    </style>

    <style name="EnterKeyStyle" parent="KeyStyle">
        <item name="android:layout_weight">1.3</item>
        <item name="android:textSize">@dimen/enter_text_size</item>
        <item name="android:tag">accent</item>
    </style>

    <style name="ToolbarKeyStyle" parent="KeyStyle">
        <item name="android:layout_width">@dimen/toolbar_button_width</item>
        <item name="android:layout_height">@dimen/toolbar_button_height</item>
        <item name="android:layout_weight">0</item>
        <item name="android:textSize">@dimen/toolbar_text_size</item>
        <item name="android:tag">mode</item>
    </style>

    <style name="SkinOptionKeyStyle" parent="KeyStyle">
        <item name="android:textSize">@dimen/skin_option_text_size</item>
        <item name="android:tag">skin_option</item>
    </style>
</resources>
