<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="#ECEFF1" android:orientation="vertical" android:padding="3dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="45dp" android:orientation="horizontal">
        <Button android:text="1" style="@style/KeyStyle"/>
        <Button android:text="2" style="@style/KeyStyle"/>
        <Button android:text="3" style="@style/KeyStyle"/>
        <Button android:text="4" style="@style/KeyStyle"/>
        <Button android:text="5" style="@style/KeyStyle"/>
        <Button android:text="6" style="@style/KeyStyle"/>
        <Button android:text="7" style="@style/KeyStyle"/>
        <Button android:text="8" style="@style/KeyStyle"/>
        <Button android:text="9" style="@style/KeyStyle"/>
        <Button android:text="0" style="@style/KeyStyle"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="55dp" android:orientation="horizontal">
        <Button android:text="ㅂ" style="@style/KeyStyle"/>
        <Button android:text="ㅈ" style="@style/KeyStyle"/>
        <Button android:text="ㄷ" style="@style/KeyStyle"/>
        <Button android:text="ㄱ" style="@style/KeyStyle"/>
        <Button android:text="ㅅ" style="@style/KeyStyle"/>
        <Button android:text="ㅛ" style="@style/KeyStyle"/>
        <Button android:text="ㅕ" style="@style/KeyStyle"/>
        <Button android:text="ㅑ" style="@style/KeyStyle"/>
        <Button android:text="ㅐ" style="@style/KeyStyle"/>
        <Button android:text="ㅔ" style="@style/KeyStyle"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="55dp" android:orientation="horizontal" android:paddingLeft="10dp" android:paddingRight="10dp">
        <Button android:text="ㅁ" style="@style/KeyStyle"/>
        <Button android:text="ㄴ" style="@style/KeyStyle"/>
        <Button android:text="ㅇ" style="@style/KeyStyle"/>
        <Button android:text="ㄹ" style="@style/KeyStyle"/>
        <Button android:text="ㅎ" style="@style/KeyStyle"/>
        <Button android:text="ㅗ" style="@style/KeyStyle"/>
        <Button android:text="ㅓ" style="@style/KeyStyle"/>
        <Button android:text="ㅏ" style="@style/KeyStyle"/>
        <Button android:text="ㅣ" style="@style/KeyStyle"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="55dp" android:orientation="horizontal">
        <Button android:text="⇧" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.3" android:layout_margin="2dp" android:backgroundTint="#CFD8DC"/>
        <Button android:text="ㅋ" style="@style/KeyStyle"/>
        <Button android:text="ㅌ" style="@style/KeyStyle"/>
        <Button android:text="ㅊ" style="@style/KeyStyle"/>
        <Button android:text="ㅍ" style="@style/KeyStyle"/>
        <Button android:text="ㅠ" style="@style/KeyStyle"/>
        <Button android:text="ㅜ" style="@style/KeyStyle"/>
        <Button android:text="ㅡ" style="@style/KeyStyle"/>
        <Button android:text="⌫" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.3" android:layout_margin="2dp" android:backgroundTint="#CFD8DC"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="55dp" android:orientation="horizontal">
        <Button android:text="!#1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.3" android:layout_margin="2dp" android:backgroundTint="#CFD8DC"/>
        <Button android:text="," style="@style/KeyStyle"/>
        <Button android:text="간격" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="4" android:layout_margin="2dp" android:backgroundTint="#FFFFFF"/>
        <Button android:text="." style="@style/KeyStyle"/>
        <Button android:text="⏎" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.3" android:layout_margin="2dp" android:backgroundTint="#42A5F5" android:textColor="#FFFFFF"/>
    </LinearLayout>
</LinearLayout>
